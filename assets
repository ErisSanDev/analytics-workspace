  <text x="62" y="172" font-family="'Segoe UI', Helvetica, Arial, sans-serif" font-size="54" font-weight="800" fill="#ffffff">Analytics Workspace</text>
  <rect x="64" y="192" width="90" height="5" rx="2.5" fill="url(#accent)"/>
  <text x="64" y="236" font-family="'Segoe UI', Helvetica, Arial, sans-serif" font-size="21" fill="#cbd5e1">Turning raw data into clear insights and confident decisions.</text>
  <text x="64" y="277" font-family="'Segoe UI', Helvetica, Arial, sans-serif" font-size="17" font-weight="600" fill="#94a3b8">Santosh Kumar  ·  Data Analyst</text>

